{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "School POS System",
  "version": "1.0.3",
  "identifier": "com.schoolpos.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Haider Memorial School POS and Inventory System",
        "width": 1360,
        "height": 850,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCRkFBQTQ0RkNFNDA2M0IKUldRN0J1VDhSS3I2V3dJN1pHLzdCWFFOcHE1OGYrOGVpbDlvb1lLUWxNWjBRMmJtem15akgxZWkK",
      "endpoints": [
        "https://github.com/DoctorOfCoding/school-pos/releases/latest/download/latest.json"
      ]
    }
  }
}
